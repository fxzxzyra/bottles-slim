using Gtk 4.0;
using Adw 1;

template $BottleView: Adw.Bin {
  Box {
    orientation: vertical;

    SearchBar search_bar {
      SearchEntry entry_search {
        placeholder-text: _("Search your containers…");
      }
    }

    Adw.Banner update_banner {
      button-label: _("Review");
      revealed: false;
    }

    Stack content_stack {
      vexpand: true;
      vhomogeneous: false;

      StackPage {
        name: "list";
        child: Adw.PreferencesPage pref_page {
          Adw.PreferencesGroup group_bottles {
            ListBox list_bottles {
              selection-mode: none;
              styles [ "boxed-list", ]
            }
          }
        };
      }

      StackPage {
        name: "empty";
        child: Adw.StatusPage bottle_status {
          title: _("Wine Containers");
        };
      }

      StackPage {
        name: "no-results";
        child: Adw.StatusPage no_bottles_found {
          icon-name: "system-search-symbolic";
          title: _("No Results Found");
          description: _("Try a different search.");
        };
      }
    }
  }
}
