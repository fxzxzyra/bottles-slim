using Gtk 4.0;
using Adw 1;

template $RenameDialog: Adw.Dialog {
  content-width: 460;
  focus-widget: entry_name;
  title: _("Rename");

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;
      [start]
      Button btn_cancel {
        label: _("Cancel");
      }

      [end]
      Button btn_save {
        label: _("Save");

        styles [
          "suggested-action",
        ]
      }
    }

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup {
        Adw.EntryRow entry_name {
          use-markup: false;
          title: _("New Name");
        }
      }
    };
  }
}
