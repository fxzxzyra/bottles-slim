using Gtk 4.0;
using Adw 1;

template $BottlesWindow: Adw.ApplicationWindow {
  title: "Bottles";
  close-request => $on_close_request();

  Adw.ToastOverlay toasts {
    Adw.NavigationView main_navigation {
      Adw.NavigationPage home_page {
        title: "Bottles";
        tag: "home";
        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar headerbar {
            title-widget: Stack header_title {
              StackPage {
                name: "switcher";
                child: Adw.ViewSwitcher view_switcher {
                  policy: wide;
                  stack: stack_main;
                };
              }
              StackPage {
                name: "title";
                child: Adw.WindowTitle window_title {
                  title: "Bottles";
                };
              }
            };

            Button btn_add {
              visible: false;
              tooltip-text: _("Create New Container");
              icon-name: "list-add-symbolic";
            }

            styles [
              "titlebar",
            ]

            [end]
            MenuButton {
              icon-name: "open-menu-symbolic";
              menu-model: primary_menu;
              tooltip-text: _("Main Menu");
              primary: true;
            }

            [end]
            ToggleButton btn_search {
              tooltip-text: _("Search");
              icon-name: "system-search-symbolic";
              visible: false;
            }
          }

          [top]
          Adw.Banner banner_offline {
            title: _("You are offline. Some components and dependencies cannot be downloaded.");
            button-label: _("Try Again");
            revealed: false;
          }

          content: Adw.ViewStack stack_main {
            vexpand: true;
          };

          [bottom]
          Adw.ViewSwitcherBar view_switcher_bar {
            stack: stack_main;
            reveal: false;
          }
        };
      }
    }
  }
}

menu primary_menu {
  section {
    item {
      label: _("Import Containers…");
      action: "app.import";
    }

    item {
      label: _("Log");
      action: "app.journal";
    }
  }

  section {
    item {
      label: _("Preferences");
      action: "app.preferences";
    }

    item {
      label: _("Keyboard Shortcuts");
      action: "win.show-help-overlay";
    }

    item {
      label: _("Help");
      action: "app.help";
    }

    item {
      label: _("About Bottles");
      action: "app.about";
    }
  }
}
