using Gtk 4.0;
using Adw 1;

Popover pop_context {
  styles [
    "menu",
  ]

  Box {
    margin-top: 6;
    margin-bottom: 6;
    margin-start: 6;
    margin-end: 6;
    orientation: vertical;

    $GtkModelButton btn_flatpak_doc {
      text: _("Troubleshooting");
      tooltip-text: "https://docs.usebottles.com/flatpak/black-screen-or-silent-crash";
    }

    Separator {}

    $GtkModelButton btn_duplicate {
      text: _("Duplicate Container…");
    }

    $GtkModelButton btn_backup_full {
      tooltip-text: _("This is the complete archive of your container, including personal files.");
      text: _("Full Backup…");
    }

    $GtkModelButton btn_backup_config {
      tooltip-text: _("This is just the container configuration, it's perfect if you want to create a new one but without personal files.");
      text: _("Export Configuration…");
    }

    Separator {}

    $GtkModelButton btn_toggle_removed {
      text: _("Show Hidden Programs");
    }

    $GtkModelButton btn_update {
      text: _("Search for new programs");
    }

    Separator {}

    $GtkModelButton btn_delete {
      text: _("Delete Container…");
    }
  }
}

Box actions {
  spacing: 6;

  Box box_backup_progress {
    visible: false;
    spacing: 4;
    tooltip-text: _("Backup in progress…");

    Spinner spinner_backup {}

    Label label_backup_progress {
      styles ["dim-label", "caption"]
    }
  }

  MenuButton {
    always-show-arrow: true;
    popover: pop_power;
    icon-name: "system-shutdown-symbolic";
  }

  MenuButton {
    popover: pop_context;
    icon-name: "view-more-symbolic";
    tooltip-text: _("Secondary Menu");
  }
}

Popover pop_power {
  styles [
    "menu",
  ]

  Box {
    orientation: vertical;
    margin-top: 6;
    margin-bottom: 6;
    margin-start: 6;
    margin-end: 6;

    $GtkModelButton btn_forcestop {
      text: _("Force Stop all Processes");
    }

    $GtkModelButton btn_nv_forcestop {
      text: _("Force Stop all Processes (Native method)");
    }

    $GtkModelButton btn_shutdown {
      text: _("Shutdown");
      tooltip-text: _("Simulate a Windows system shutdown");
    }

    $GtkModelButton btn_reboot {
      text: _("Reboot");
      tooltip-text: _("Simulate a Windows system reboot");
    }
  }
}

Popover popover_exec_settings {
  width-request: 300;

  Box {
    orientation: vertical;
    margin-top: 6;
    margin-bottom: 6;
    margin-start: 6;
    margin-end: 6;

    Label {
      halign: start;
      margin-bottom: 12;
      label: _("Launch Options");

      styles [
        "heading"
      ]
    }

    Entry exec_arguments {}

    Separator {
      margin-top: 12;
      margin-bottom: 12;
    }

    CheckButton exec_terminal {
      Label {
        label: _("Run in Terminal");
        margin-start: 6;
      }
    }

    CheckButton exec_winebridge {
      Label {
        label: _("Use WineBridge");
        margin-start: 6;
      }
    }
  }
}

template $DetailsBottle: Adw.Bin {
  vexpand: true;
  Overlay {
    Adw.PreferencesPage {
      Adw.PreferencesGroup {
        Adw.Clamp {
          maximum-size: 720;

          Box {
            orientation: vertical;
            spacing: 12;

            Label label_name {
              halign: center;
              justify: center;
              wrap: true;
              max-width-chars: 30;
              label: _("My container");
              wrap-mode: word_char;
              use-markup: false;

              styles [
                "title-1",
              ]
            }

            Adw.WrapBox {
              child-spacing: 6;
              line-spacing: 6;
              align: 0.5;

              Box {
                spacing: 6;

                styles [
                  "tag",
                ]

                Label label_arch {
                  label: _("Win64");

                  styles [
                    "heading",
                  ]
                }
              }

              Box {
                spacing: 6;

                styles [
                  "tag",
                ]

                Label label_environment {
                  label: _("Preset");

                  styles [
                    "heading",
                  ]
                }
              }

              Box {
                spacing: 6;

                styles [
                  "tag",
                ]

                Label label_runner {
                  max-width-chars: 24;
                  ellipsize: middle;
                  tooltip-text: bind label_runner.label;
                  label: _("Runner");

                  styles [
                    "heading",
                  ]
                }
              }

              Box versioning_badge {
                halign: center;
                valign: center;

                styles [
                  "tag",
                ]

                Box {
                  spacing: 6;

                  Image {
                    icon-name: "view-wrapped-symbolic";
                  }

                  Label label_state {
                    max-width-chars: 24;
                    ellipsize: middle;
                    tooltip-text: bind label_state.label;
                    label: "main";
                  }
                }
              }
            }
          }
        }
      }

      Adw.PreferencesGroup {
        title: _("Quick Actions");

        Adw.ActionRow {
          title: _("Run Executable…");
          activatable-widget: btn_execute;

          [suffix]
          MenuButton btn_exec_settings {
            valign: center;
            icon-name: "applications-system-symbolic";
            tooltip-text: _("Launch Options");
            popover: popover_exec_settings;
            styles [ "flat", ]
          }

          [suffix]
          Button btn_execute {
            valign: center;
            icon-name: "media-playback-start-symbolic";
            tooltip-text: _("Run Executable…");
            styles [ "flat", ]
          }
        }

        Adw.ActionRow {
          title: _("Analyze an Executable");
          activatable-widget: btn_eagle;

          [suffix]
          Button btn_eagle {
            valign: center;
            icon-name: "com.usebottles.eagle-symbolic";
            tooltip-text: _("Analyze an Executable");
            styles [ "flat", ]
          }
        }

        Adw.ActionRow {
          title: _("Open Folder");
          activatable-widget: btn_browse;

          [suffix]
          Button btn_browse {
            valign: center;
            icon-name: "document-open-symbolic";
            tooltip-text: _("Open Folder");
            styles [ "flat", ]
          }
        }
      }

      Adw.PreferencesGroup group_programs {
        title: _("Programs");

        Adw.ActionRow row_no_programs {
          subtitle: _("Add a program to keep it in this list, or browse community installers.");
        }

        Adw.PreferencesRow bottom_bar {
          activatable: false;
          focusable: false;

          Box {
            Button add_shortcuts {
              hexpand: true;

              Box {
                halign: center;

                Image {
                  icon-name: "list-add-symbolic";
                }

                Separator {
                  styles [
                    "spacer"
                  ]
                }

                Label {
                  label: _("Add Program…");
                }
              }

              styles [
                "flat"
              ]
            }

            Separator {}

            Button install_programs {
              hexpand: true;

              Box {
                halign: center;

                Image {
                  icon-name: "folder-download-symbolic";
                }

                Separator {
                  styles [
                    "spacer"
                  ]
                }

                Label {
                  label: _("Browse Installers");
                }
              }

              styles [
                "flat"
              ]
            }

            styles [
              "linked"
            ]
          }

          styles [
            "bottom-bar"
          ]
        }
      }

      Adw.PreferencesGroup group_updates {
        title: _("Updates");
      }

      Adw.PreferencesGroup group_options {
        title: _("Options");

        Adw.ActionRow row_preferences {
          activatable: true;
          title: _("Settings");

          Image {
            icon-name: "go-next-symbolic";
          }
        }

        Adw.ActionRow row_dependencies {
          activatable: true;
          title: _("Dependencies");
          subtitle: _("Install dependencies for programs.");

          Image {
            icon-name: "go-next-symbolic";
          }
        }

        Adw.ActionRow row_registry_rules {
          activatable: true;
          title: _("Registry Rules");
          subtitle: _("Manage reusable registry tweaks.");

          Image {
            icon-name: "go-next-symbolic";
          }
        }

        Adw.ActionRow row_snapshots {
          activatable: true;
          title: _("Snapshots");

          [suffix]
          Button btn_snapshots_settings {
            tooltip-text: _("Snapshot Settings");
            valign: center;
            icon-name: "emblem-system-symbolic";
            styles [ "flat" ]
          }

          Image {
            icon-name: "go-next-symbolic";
          }
        }

        Adw.ActionRow row_taskmanager {
          activatable: true;
          title: _("Task Manager");

          Image {
            icon-name: "go-next-symbolic";
          }
        }
      }

      Adw.PreferencesGroup group_utilities {
        title: _("Tools");

        Adw.ActionRow row_cmd {
          activatable: true;
          title: _("Command Line");
          subtitle: _("Run commands inside the Container.");

          Image {
            icon-name: "external-link-symbolic";
          }
        }

        Adw.ActionRow row_regedit {
          activatable: true;
          title: _("Registry Editor");
          subtitle: _("Edit the internal registry.");

          Image {
            icon-name: "external-link-symbolic";
          }
        }

        Adw.ExpanderRow {
          title: _("Legacy Wine Tools");

          Adw.ActionRow row_explorer {
            activatable: true;
            title: _("Explorer");

            Image {
              icon-name: "external-link-symbolic";
            }
          }

          Adw.ActionRow row_taskmanager_legacy {
            activatable: true;
            title: _("Task Manager");

            Image {
              icon-name: "external-link-symbolic";
            }
          }

          Adw.ActionRow row_debug {
            activatable: true;
            title: _("Debugger");

            Image {
              icon-name: "external-link-symbolic";
            }
          }

          Adw.ActionRow row_winecfg {
            activatable: true;
            title: _("Configuration");

            Image {
              icon-name: "external-link-symbolic";
            }
          }

          Adw.ActionRow row_uninstaller {
            activatable: true;
            title: _("Uninstaller");

            Image {
              icon-name: "external-link-symbolic";
            }
          }

          Adw.ActionRow row_controlpanel {
            activatable: true;
            title: _("Control Panel");

            Image {
              icon-name: "external-link-symbolic";
            }
          }
        }
      }
    }

    [overlay]
    Adw.StatusPage drop_overlay {
      visible: false;
      can-target: false;
      icon-name: "system-run-symbolic";
      title: _("Drop files to execute them");
      styles [ "dragndrop_overlay", ]
    }
  }
}
