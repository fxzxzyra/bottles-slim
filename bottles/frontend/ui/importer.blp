using Gtk 4.0;
using Adw 1;

template $ImporterView: Adw.Bin {
  Adw.ToolbarView {
    [top]
    Adw.HeaderBar headerbar {
      show-back-button: false;
      title-widget: Adw.WindowTitle window_title { title: _("Import Containers"); };
      [start]
      Button btn_back {
        tooltip-text: _("Go Back");
        icon-name: "go-previous-symbolic";
      }
    }

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup {
        visible: bind box_import_progress.visible;
        Box box_import_progress {
          visible: false;
          spacing: 12;
          Spinner spinner_import {}
          Label label_import_progress {
            wrap: true;
            xalign: 0;
          }
        }
      }

      Adw.PreferencesGroup {
        title: _("Existing Containers");
        description: _("Register a container in its current directory. Its files stay where they are.");
        Adw.ActionRow {
          title: _("Register an Existing Container");
          activatable-widget: btn_import_existing;
          [suffix]
          Button btn_import_existing {
            label: _("Choose Directory…");
            valign: center;
          }
        }
      }

      Adw.PreferencesGroup {
        title: _("Backups");
        description: _("Restore an archive or use a configuration to create a container in an empty directory.");
        Adw.ActionRow {
          title: _("Restore a Container Backup");
          activatable-widget: btn_import_backup;
          [suffix]
          MenuButton btn_import_backup {
            label: _("Choose Backup…");
            popover: pop_backup;
            valign: center;
          }
        }
      }
    };
  }
}

Popover pop_backup {
  styles [ "menu", ]
  Box {
    orientation: vertical;
    margin-top: 6;
    margin-bottom: 6;
    margin-start: 6;
    margin-end: 6;
    $GtkModelButton btn_import_config {
      text: _("Configuration File…");
      tooltip-text: _("Create a container from saved settings without restoring personal files");
    }
    $GtkModelButton btn_import_full {
      text: _("Full Archive…");
      tooltip-text: _("Restore the container including its programs and personal files");
    }
  }
}
