using Gtk 4.0;
using Adw 1;

template $ImporterView: Adw.Bin {
  Adw.ToolbarView {
    [top]
    Adw.HeaderBar headerbar {
      show-back-button: false;
      title-widget: Adw.WindowTitle window_title { title: _("Import Bottles"); };
      [start]
      Button btn_back {
        tooltip-text: _("Go Back");
        icon-name: "go-previous-symbolic";
      }
    }

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup {
        visible: bind box_import_progress.visible;
        Box box_import_progress {
          visible: false;
          spacing: 12;
          Spinner spinner_import {}
          Label label_import_progress {
            wrap: true;
            xalign: 0;
          }
        }
      }

      Adw.PreferencesGroup {
        title: _("Existing Bottles");
        description: _("Register a bottle in its current directory. Its files stay where they are.");
        Adw.ActionRow {
          title: _("Register an Existing Bottle");
          activatable-widget: btn_import_existing;
          [suffix]
          Button btn_import_existing {
            label: _("Choose Directory…");
            valign: center;
          }
        }
      }

      Adw.PreferencesGroup {
        title: _("Backups");
        description: _("Restore an archive or use a configuration to create a bottle in an empty directory.");
        Adw.ActionRow {
          title: _("Restore a Bottle Backup");
          activatable-widget: btn_import_backup;
          [suffix]
          MenuButton btn_import_backup {
            label: _("Choose Backup…");
            popover: pop_backup;
            valign: center;
          }
        }
      }

      Adw.PreferencesGroup {
        title: _("Other Wine Prefixes");
        description: _("Find Wine environments from other applications, then choose one to copy into a new bottle.");
        [header-suffix]
        Box {
          spacing: 6;
          Button btn_select_prefixes {
            label: _("Choose Directory…");
            tooltip-text: _("Find Wine Prefixes in a Directory");
            valign: center;
          }
          Button btn_find_prefixes {
            tooltip-text: _("Search Known Locations");
            icon-name: "view-refresh-symbolic";
            valign: center;
          }
        }
        Stack stack_prefixes {
          StackPage {
            name: "empty";
            child: Adw.StatusPage status_page {
              icon-name: "folder-open-symbolic";
              title: _("Find Wine Prefixes");
              description: _("Choose a directory or search known locations to get started.");
            };
          }
          StackPage {
            name: "searching";
            child: Adw.StatusPage {
              title: _("Searching for Wine Prefixes…");
              child: Spinner { spinning: true; halign: center; };
            };
          }
          StackPage {
            name: "prefixes";
            child: Box group_prefixes {
              orientation: vertical;
              ListBox list_prefixes {
                selection-mode: none;
                styles [ "boxed-list", ]
              }
            };
          }
        }
      }
    };
  }
}

Popover pop_backup {
  styles [ "menu", ]
  Box {
    orientation: vertical;
    margin-top: 6;
    margin-bottom: 6;
    margin-start: 6;
    margin-end: 6;
    $GtkModelButton btn_import_config {
      text: _("Configuration File…");
      tooltip-text: _("Create a bottle from saved settings without restoring personal files");
    }
    $GtkModelButton btn_import_full {
      text: _("Full Archive…");
      tooltip-text: _("Restore the bottle including its programs and personal files");
    }
  }
}
