using Gtk 4.0;
using Adw 1;

template $Details: Adw.Bin {
  Adw.NavigationView section_navigation {
    Adw.NavigationPage overview_page {
      title: _("Details");
      tag: "overview";
      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar sidebar_headerbar {
          show-back-button: false;
          [start]
          Button btn_back {
            icon-name: "go-previous-symbolic";
            tooltip-text: _("Go Back");
          }
          [end]
          Box default_actions {}
        }
        content: Box default_view {
          orientation: vertical;
        };
      };
    }
    Adw.NavigationPage section_page {
      title: _("Settings");
      tag: "section";
      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar content_headerbar {
          show-back-button: false;
          title-widget: Adw.WindowTitle content_title {};
          [start]
          Button btn_back_sidebar {
            icon-name: "go-previous-symbolic";
            tooltip-text: _("Go Back");
          }
          [end]
          Box box_actions {}
          [end]
          MenuButton btn_operations {
            visible: false;
            tooltip-text: _("Operations");
            popover: pop_tasks;
            Spinner spinner_tasks {}
            styles [ "flat", ]
          }
        }
        content: Stack stack_bottle {
          transition-type: crossfade;
          hexpand: true;
          vexpand: true;
        };
      };
    }
  }
}

Popover pop_tasks {
  Box {
    orientation: vertical;
    spacing: 3;

    Box {
      orientation: vertical;

      ListBox list_tasks {
        selection-mode: none;

        styles [
          "content",
        ]
      }
    }
  }
}
